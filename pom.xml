<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>soys</groupId>
    <artifactId>SOYSGiftLoft</artifactId>
    <version>1.9.0</version>
    <packaging>jar</packaging>

    <name>SOYSGiftLoft</name>

    <properties>
        <java.version>1.8</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.8.1</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                </configuration>
            </plugin>
        <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-shade-plugin</artifactId>
            <version>3.2.4</version>
            <executions>
                <execution>
                    <phase>package</phase>
                    <goals>
                        <goal>shade</goal>
                    </goals>
            <configuration>
                <createDependencyReducedPom>false</createDependencyReducedPom>
                <filters>
                    <filter>
                        <artifact>*:*</artifact>
                        <excludes>
                            <exclude>META-INF/*.SF</exclude>
                            <exclude>META-INF/*.DSA</exclude>
                            <exclude>META-INF/*.RSA</exclude>
                        </excludes>
                    </filter>
                </filters>
            </configuration>
                </execution>
            </executions>
        </plugin>
        </plugins>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
    </build>

    <repositories>
        <!-- PlayerPoints -->
        <repository>
            <id>codemc-repo</id>
            <url>https://repo.codemc.io/repository/maven-public/</url>
        </repository>
        <repository>
            <id>rosewooddev-repo</id>
            <url>https://repo.rosewooddev.io/repository/public/</url>
        </repository>
        <!-- PlaceholderAPI -->
        <repository>
            <id>placeholderapi-repo</id>
            <url>https://repo.extendedclip.com/content/repositories/placeholderapi/</url>
        </repository>
        <!-- Spigot API -->
        <repository>
            <id>spigot-repo</id>
            <url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- Spigot 1.12.2 API -->
        <dependency>
            <groupId>org.spigotmc</groupId>
            <artifactId>spigot-api</artifactId>
            <version>1.12.2-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>

        <!-- Vault (经济，服务端提供) -->
        <dependency>
            <groupId>net.milkbowl.vault</groupId>
            <artifactId>VaultAPI</artifactId>
            <version>1.7</version>
            <scope>provided</scope>
        </dependency>

        <!-- PlayerPoints (点券，服务端提供) -->
        <!-- Source: https://mvnrepository.com/artifact/org.black_ixx/playerpoints -->
        <dependency>
            <groupId>org.black_ixx</groupId>
            <artifactId>playerpoints</artifactId>
            <version>2.1.3</version>
            <scope>provided</scope>
        </dependency>

        <!-- PlaceholderAPI (占位符，服务端提供) -->
        <dependency>
            <groupId>me.clip</groupId>
            <artifactId>placeholderapi</artifactId>
            <version>2.11.6</version>
            <scope>provided</scope>
        </dependency>

        <!--
            JDBC 驱动说明：
            与 SOYSLinkTeam 保持一致，Spigot 1.12.2 服务端已内置 MySQL Connector/J 与 SQLite JDBC，
            因此统一使用 provided，不打包进插件，避免 jar 体积膨胀与驱动冲突。
            若服务端缺失驱动，插件会在启用对应后端时给出明确报错提示。
        -->
        <dependency>
            <groupId>mysql</groupId>
            <artifactId>mysql-connector-java</artifactId>
            <version>8.0.28</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.36.0.3</version>
            <scope>provided</scope>
        </dependency>

        <!--
            SOYSHTTPOverMC（HTTP-over-MC 网关 + 注解式 Web API）：
            运行时由服务器提供（softdepend，见 plugin.yml），编译期引用其构建产物
            （1.12.2 shaded jar，与 MCERP 同一引用范式）。
            Spring 式能力（@RequestMapping/@GetMapping/AjaxResult/SoysExpansion 等）
            全部来自本依赖——不引入 spring-boot-starter-web（禁内嵌 Tomcat）。
            升级方式：SOYSHTTPOverMC 重新 package 后同步修改下方 version 与 systemPath。
        -->
        <dependency>
            <groupId>com.github.cocosoys.mc</groupId>
            <artifactId>soyshttpovermc</artifactId>
            <version>1.4.1</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/../SOYSHTTPOverMC/core/target/SOYSHTTPOverMC-1_12-1.4.1.jar</systemPath>
        </dependency>

        <!--
            MCERP（ERP 管理面宿主，softdepend 见 plugin.yml）：
            运行时由服务器提供，编译期引用其 original jar（shade 前的纯 MCERP 类，
            不重复捆绑 SOYS/jackson 等传递依赖，避免与上方 soyshttpovermc 依赖产生类冲突）。
            SoysGiftLoftErpExpansion（McerpExpansion 子类）/ ErpMenus / ControllerPermScanner 来自本依赖。
            升级方式：MCERP 重新 package 后同步修改下方 version 与 systemPath。
        -->
        <dependency>
            <groupId>com.github.cocosoys.mc</groupId>
            <artifactId>MCERP</artifactId>
            <version>1.0-SNAPSHOT</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/../MCERP/target/original-MCERP-1.0-SNAPSHOT.jar</systemPath>
        </dependency>
    </dependencies>
</project>
